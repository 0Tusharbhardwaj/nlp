# ==============================================================================
# SecureCode AI - Environment Configuration Template
# Copy this file to .env and adjust variables according to your local setup.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
API_PREFIX=/api/v1

# Security & CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=results/logs/app.log

# ML Model Paths & Checkpoints (Local or Mounted Google Drive)
BASE_CONFIG_PATH=configs/base.yaml
MODEL_DIR=results/models
CHECKPOINT_DIR=results/checkpoints
DEVIGN_PROCESSED_PATH=datasets/processed/devign
CODEBERT_MODEL_PATH=results/models/codebert_finetuned

# Google Colab / Drive Integration (Used when executing in cloud environments)
GOOGLE_DRIVE_MOUNT_PATH=/content/drive/MyDrive/SecureCode-AI
USE_COLAB_STORAGE=False

# Hardware Acceleration
DEVICE=auto
RANDOM_SEED=42
