# SecureCode AI Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application and models
COPY backend/ ./backend/
COPY src/ ./src/
COPY configs/ ./configs/
COPY datasets/reports/ ./datasets/reports/
COPY datasets/processed/ ./datasets/processed/
COPY results/models/ ./results/models/
COPY results/metrics/ ./results/metrics/

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
