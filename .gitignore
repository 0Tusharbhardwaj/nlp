# ==============================================================================
# SecureCode AI - Git Ignore Configuration
# Ensures reproducibility while keeping large checkpoints, virtual environments,
# and system artifacts out of version control.
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
secrets.yaml
credentials.json

# Large Archives & Raw Downloads (Preserve processed research benchmarks)
*.parquet
*.arrow
*.tar.gz
*.zip
*.7z
datasets/raw/*
datasets/processed/*
!datasets/raw/*/*.jsonl
!datasets/processed/*/*.jsonl
!datasets/processed/*/*.json
!datasets/raw/**/.gitkeep
!datasets/processed/**/.gitkeep

# Heavy Deep Learning Checkpoints (>100MB)
checkpoints/
models/weights/
results/checkpoints/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Allow serialized classical baseline models (tiny ~2KB joblib files)
!results/models/*.joblib

# Experiment & Evaluation Outputs
results/runs/
results/logs/
*.log
events.out.tfevents.*
wandb/
mlruns/

# Google Colab & Google Drive mounts
/content/drive/
.colab/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Frontend (Node / React)
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.next/
frontend/.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
